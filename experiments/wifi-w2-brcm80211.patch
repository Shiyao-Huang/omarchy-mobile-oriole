+		  why, h[0], h[1],
+		  h[devinfo->h2d_r_idx_off / 4], h[devinfo->h2d_r_idx_off / 4 + 1],
+		  h[devinfo->d2h_w_idx_off / 4], h[devinfo->d2h_w_idx_off / 4 + 1],
+		  h[devinfo->d2h_w_idx_off / 4 + 2],
+		  h[devinfo->d2h_r_idx_off / 4], h[devinfo->d2h_r_idx_off / 4 + 1],
+		  h[devinfo->d2h_r_idx_off / 4 + 2]);
+	brcmf_dbg(PCIE, "%s: TCM H2D w %u %u r %u %u, D2H w %u %u %u r %u %u %u, mailboxint 0x%08x\n",
+		  why,
