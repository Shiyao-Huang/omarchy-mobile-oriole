#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-device-oriole into DESTDIR. Nothing is enabled that would
# mark a slot successful or start the radio, the charger, or a camera.
#   ./install DESTDIR [BUILDDIR]
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
stage() {
  local mode=$1 source=$2 target=$3
  mkdir -p "$destination/$(dirname -- "$target")"
  install -m "$mode" "$source" "$destination/$target"
}
stage 755 "$build/reboot-to" usr/bin/reboot-to
stage 644 vendor/udev/rules.d/10-omamobile-storage.rules usr/lib/udev/rules.d/10-omamobile-storage.rules
stage 644 vendor/systemd/network/20-usb-gadget.network usr/lib/systemd/network/20-usb-gadget.network
stage 644 vendor/systemd/logind.conf.d/10-omamobile-lid.conf usr/lib/systemd/logind.conf.d/10-omamobile-lid.conf
stage 644 vendor/systemd/logind.conf.d/10-omamobile-power-key.conf usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf
stage 644 vendor/NetworkManager/conf.d/10-omamobile-usb.conf usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf
stage 755 vendor/systemd/system/omamobile-network-smoke usr/bin/omamobile-network-smoke
stage 755 vendor/systemd/system/omamobile-agent-network-smoke usr/bin/omamobile-agent-network-smoke
stage 755 vendor/systemd/system/omamobile-network-recover usr/bin/omamobile-network-recover
stage 755 vendor/systemd/system/oriole-hardware-smoke usr/bin/oriole-hardware-smoke
stage 755 vendor/systemd/system/oriole-optional-profile usr/bin/oriole-optional-profile
stage 644 device.conf usr/share/omamobile/device.conf
stage 644 etc/omamobile-mirrorlist etc/pacman.d/omamobile-mirrorlist
stage 644 LICENSE usr/share/licenses/omamobile-device-oriole/LICENSE
stage 644 version usr/share/omamobile/device-oriole/version
stage 644 optional/README.md usr/share/omamobile/device-oriole/optional/README.md
stage 644 optional/wifi/90-bcmdhd-unmanaged.conf usr/share/omamobile/device-oriole/optional/wifi/90-bcmdhd-unmanaged.conf
stage 644 optional/camera/oriole-camera.modules-load usr/share/omamobile/device-oriole/optional/camera/oriole-camera.modules-load
stage 644 optional/camera/oriole-camera.modprobe usr/share/omamobile/device-oriole/optional/camera/oriole-camera.modprobe
stage 644 optional/camera/90-oriole-camera.rules usr/share/omamobile/device-oriole/optional/camera/90-oriole-camera.rules
stage 644 optional/camera/90-oriole-camera.wireplumber.conf usr/share/omamobile/device-oriole/optional/camera/90-oriole-camera.wireplumber.conf
stage 644 optional/performance/90-oriole-sched.conf usr/share/omamobile/device-oriole/optional/performance/90-oriole-sched.conf
stage 644 optional/performance/oriole-cpufreq-ratelimit.service usr/share/omamobile/device-oriole/optional/performance/oriole-cpufreq-ratelimit.service
