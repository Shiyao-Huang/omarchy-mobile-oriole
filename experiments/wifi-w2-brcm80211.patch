+		  brcmf_pcie_read_tcm32(devinfo, devinfo->tcm_d2h_w_idx),
+		  brcmf_pcie_read_tcm32(devinfo, devinfo->tcm_d2h_w_idx + sz),
+		  brcmf_pcie_read_tcm32(devinfo, devinfo->tcm_d2h_w_idx + 2 * sz),
+		  brcmf_pcie_read_tcm32(devinfo, devinfo->tcm_d2h_r_idx),
+		  brcmf_pcie_read_tcm32(devinfo, devinfo->tcm_d2h_r_idx + sz),
