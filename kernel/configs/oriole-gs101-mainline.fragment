# SPDX-License-Identifier: GPL-2.0-only
# Required hardware boundary for Pixel 6 (oriole) on M8's GS101 tree.
# Merge this fragment after the exact source commit and the 38-device patch
# series. It intentionally does not contain firmware paths or calibration.
CONFIG_DRM_GS101=m
CONFIG_DRM_PANFROST=m
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_PCIE_GS101=y
# bcmdhd, samsung-iommu and CPIF are external modules, built explicitly by
# tools/build-oriole-kernel. Their settings cannot survive olddefconfig.
CONFIG_VIDEO_GS101_MIPI_CSIS=m
CONFIG_VIDEO_IMX355=m
CONFIG_VIDEO_IMX386=m
CONFIG_VIDEO_S5KGN1=m
CONFIG_INPUT_CS40L2X=m
CONFIG_UCLAMP_TASK=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CMA_SIZE_MBYTES=384
CONFIG_LOCALVERSION="-omamobile-oriole-hw"
