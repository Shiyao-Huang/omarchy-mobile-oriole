#!/bin/bash
# SPDX-License-Identifier: MIT
# Read-only network acceptance check for an Omarchy Mobile phone.
# It intentionally prints interface names and addresses only; it never prints
# SSIDs, MAC addresses, credentials, NetworkManager profiles, or full routes.
set -euo pipefail

endpoint=${1:-api.github.com}
url=${2:-https://api.github.com/rate_limit}
sys_root=${ORIOLE_SYS_ROOT:-/sys}
fail=0
say() { printf '%s\n' "$*"; }
need() {
  command -v "$1" >/dev/null 2>&1 || { say "FAIL missing command: $1"; fail=1; }
}
for cmd in ip getent curl; do need "$cmd"; done
(( fail == 0 )) || exit 2

wireless=()
for path in "$sys_root"/class/net/*/wireless; do
  [[ -d "$path" ]] || continue
  wireless+=("${path%/wireless}")
done
if ((${#wireless[@]} == 0)); then
  say 'FAIL no wireless interface (wlan0 expected)'
  exit 3
fi
say "PASS wireless interface count=${#wireless[@]}"
for path in "${wireless[@]}"; do
  name=${path##*/}
  state=$(cat "${path%/wireless}/operstate" 2>/dev/null || printf unknown)
  say "INFO interface=$name state=$state"
done

family=
if ip -4 addr show dev "${wireless[0]}" scope global | grep -Eq 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' \
    && ip -4 route show default dev "${wireless[0]}" | grep -q '^default '; then
  family=4
  say 'PASS wireless IPv4 address present'
elif ip -6 addr show dev "${wireless[0]}" scope global | grep -Eq 'inet6 [0-9A-Fa-f:.]+' \
    && ip -6 route show default dev "${wireless[0]}" | grep -q '^default '; then
  family=6
  say 'PASS wireless IPv6 address present'
else
  say 'FAIL wireless interface has no IPv4 or IPv6 address'
  exit 4
fi
say "PASS wireless IPv$family default route present"

if ! getent ahosts "$endpoint" >/dev/null; then
  say "FAIL DNS resolution: $endpoint"
  exit 6
fi
say "PASS DNS resolution: $endpoint"

if ! curl --fail --silent --show-error --connect-timeout 5 --max-time 15 \
    --output /dev/null "$url"; then
  say "FAIL HTTPS request: $url"
  exit 7
fi
say "PASS HTTPS request: $url"
say 'PASS network smoke test'
